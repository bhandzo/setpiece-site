---
import { getImage } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";

import CoverImage from "@/components/blog/CoverImage.astro";
import Masthead from "@/components/blog/Masthead.astro";
import homepage from "@/content/homepage.json";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { coverImage, ogImage, title, description, updatedDate, publishDate } = post.data;
const coverSocialImage = coverImage
	? await getImage({
			src: coverImage.src,
			width: 1200,
			height: 627,
			fit: "cover",
			format: "jpg",
			quality: "max",
		})
	: undefined;
const socialImage = ogImage ?? coverSocialImage?.src ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { remarkPluginFrontmatter } = await render(post);
const readingTime: string = remarkPluginFrontmatter.readingTime;
const bookingUrl = homepage.heroCtaUrl.trim();
---

<BaseLayout
	meta={{
		articleDate,
		description,
		ogImage: socialImage,
		title,
	}}
>
	<article class="gc-full" data-pagefind-body>
		<div class="mx-auto w-full max-w-[41rem]">
			<div id="blog-hero" class="py-baseline border-b border-(--hairline)">
				<Masthead content={post} readingTime={readingTime} />
			</div>
			{
				post.data.coverImage && (
					<div class="py-baseline">
						<CoverImage src={post.data.coverImage.src} alt={post.data.coverImage.alt} />
					</div>
				)
			}
			<div class="py-baseline">
				<div class="prose prose-blog prose-headings:font-semibold prose-headings:text-accent-2">
					<slot />
				</div>
			</div>
			<footer aria-labelledby="post-setpiece-cta" class="bg-bone my-8 p-6 md:my-10 md:p-8">
				<h2 id="post-setpiece-cta" class="display text-2xl md:text-3xl">
					We are Operating Partners, Not Consultants
				</h2>
				<p class="mt-4 max-w-[38em] leading-relaxed italic">
					Setpiece is Kim Nortman and Ben Handzo. We embed with leadership teams as AI-native
					operating partners and do the work alongside you.
				</p>
				{
					bookingUrl.length > 0 && (
						<a
							class="text-link mt-4 inline-block font-semibold underline underline-offset-4"
							href={bookingUrl}
							rel="noopener"
						>
							Book an intro call
						</a>
					)
				}
			</footer>
		</div>
	</article>
</BaseLayout>
<button
	class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
	data-show="false"
	id="to-top-btn"
>
	<span class="sr-only">Back to top</span>
	<svg
		aria-hidden="true"
		class="h-6 w-6"
		fill="none"
		focusable="false"
		stroke="currentColor"
		stroke-width="2"
		viewBox="0 0 24 24"
		xmlns="http://www.w3.org/2000/svg"
	>
		<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
</button>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
