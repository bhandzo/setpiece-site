---
// ABOUTME: Decorative rugby set-play notation SVG for the homepage hero, traced from the owner's
// ABOUTME: prototype: thin logo-style run arrows, two orange passes, dotted support arc. Rendered
// ABOUTME: contain-fit (never cropped) at any hero shape via preserveAspectRatio xMidYMax meet.
---

<svg
  aria-hidden="true"
  class="set-play"
  fill="none"
  preserveAspectRatio="xMidYMax meet"
  viewBox="0 0 1280 720"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- Reveal mask so the dotted support arc can draw without fighting its dot pattern -->
    <mask id="set-play-arc-mask" maskUnits="userSpaceOnUse">
      <path
        class="set-play-arc-reveal"
        d="M120 450 C160 600 405 655 660 530"
        stroke="#fff"
        stroke-width="12"
      ></path>
    </mask>
  </defs>

  <!-- Stage 1 — positions on the field: open circles at the feet, ball-carrier's dash -->
  <g class="set-play-static">
    <!-- pass-1 origin: open circle at the left edge of the field -->
    <circle class="set-play-open" cx="118" cy="432" r="8" stroke-width="2.5"></circle>

    <!-- feet of the two short forward-run arrows -->
    <circle class="set-play-open" cx="236" cy="531" r="9" stroke-width="2.5"></circle>
    <circle class="set-play-open" cx="397" cy="557" r="9" stroke-width="2.5"></circle>

    <!-- foot of the long center run arrow -->
    <circle class="set-play-open-bold" cx="524" cy="690" r="10" stroke-width="3"></circle>

    <!-- position past the long arrow, below pass 2 -->
    <circle class="set-play-open-bold" cx="716" cy="489" r="10" stroke-width="3"></circle>
    <!-- its forward run is drawn in stage 2 (run-e) -->

    <!-- foot of the up-right run arrow (a true circle, per the prototype);
         held above the description text zone (viewBox x>768, lower right) -->
    <circle class="set-play-open" cx="952" cy="394" r="9" stroke-width="2.5"></circle>
  </g>

  <!-- Stage 2 — black forward-run arrows: thin strokes, small open barbs (logo notation) -->
  <path class="set-play-run set-play-run-a" d="M239 505 L256 395" stroke-linecap="round"></path>
  <path
    class="set-play-head set-play-head-a"
    d="M245 409 L256 395 L262 412"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path class="set-play-run set-play-run-b" d="M399 531 L421 394" stroke-linecap="round"></path>
  <path
    class="set-play-head set-play-head-b"
    d="M410 408 L421 394 L427 411"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path class="set-play-run set-play-run-c" d="M530 674 L629 345" stroke-linecap="round"></path>
  <path
    class="set-play-head set-play-head-c"
    d="M616 357 L629 345 L633 363"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path class="set-play-run set-play-run-e" d="M721 470 L748 365" stroke-linecap="round"></path>
  <path
    class="set-play-head set-play-head-e"
    d="M736 378 L748 365 L753 382"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path class="set-play-run set-play-run-d" d="M962 375 L1051 194" stroke-linecap="round"></path>
  <path
    class="set-play-head set-play-head-d"
    d="M1036 204 L1051 194 L1052 212"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  <!-- Stage 3 — orange pass 1; the dotted support arc loops behind the line -->
  <path class="set-play-pass1" d="M130 432 L592 424" stroke-linecap="round"></path>
  <path
    class="set-play-pass1-head"
    d="M573 413 L592 424 L573 435"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path
    class="set-play-arc"
    d="M120 450 C160 600 405 655 660 530"
    mask="url(#set-play-arc-mask)"
    stroke-linecap="round"
  ></path>
  <path
    class="set-play-arc-head"
    d="M642 529 L660 530 L650 545"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>

  <!-- Stage 4 — orange pass 2, higher and further right -->
  <path class="set-play-pass2" d="M680 337 L980 330" stroke-linecap="round"></path>
  <path
    class="set-play-pass2-head"
    d="M961 319 L980 330 L961 341"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>

<style>
  /* Mobile: the play renders as its own block above the headline (full composition).
			   md+: it becomes the hero's background layer. preserveAspectRatio "xMidYMax meet"
			   letterboxes instead of cropping, so the whole 1280x720 poster stays visible at
			   every hero shape — scaled to fit, centered, anchored to the hero's bottom. */
  .set-play {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .set-play {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }
  }

  /* ---- palette + weight: everything speaks the logo's thin-stroke arrow
		 language; the dotted arc is the quietest mark on the field ---- */
  .set-play-open,
  .set-play-open-bold {
    stroke: var(--color-ink);
  }

  .set-play-run,
  .set-play-head {
    stroke: var(--color-ink);
    stroke-width: 3;
  }

  .set-play-pass1,
  .set-play-pass1-head,
  .set-play-pass2,
  .set-play-pass2-head {
    stroke: var(--color-orange);
    stroke-width: 3;
  }

  .set-play-arc,
  .set-play-arc-head {
    stroke: var(--color-ink);
    stroke-width: 3;
  }
  .set-play-arc {
    stroke-dasharray: 0.1 11;
  }

  /* Poster-stamp scale: the block renders ~350px wide, so thicken every mark
		 proportionally or the play reads as a wisp. */
  @media (max-width: 767px) {
    .set-play-run,
    .set-play-head {
      stroke-width: 5;
    }
    .set-play-pass1,
    .set-play-pass1-head,
    .set-play-pass2,
    .set-play-pass2-head {
      stroke-width: 5;
    }
    .set-play-arc,
    .set-play-arc-head {
      stroke-width: 4.5;
    }
    .set-play-arc {
      stroke-dasharray: 0.1 16;
    }
    .set-play-open {
      stroke-width: 4;
      r: 12px;
    }
    .set-play-open-bold {
      stroke-width: 4.5;
      r: 14px;
    }
  }

  /* ---- one-time on-load sequence (client-approved stage order) ----
		 1. 0ms      positions fade in
		 2. +300ms   black run arrows draw, barbs land as each completes
		 3. +800ms   orange pass 1 draws, dotted support arc loops behind the line
		 4. +1500ms  orange pass 2 draws left-to-right                       */
  .set-play-static {
    opacity: 0;
    animation: set-play-appear 200ms ease-out forwards;
  }

  .set-play-run-a {
    stroke-dasharray: 112;
    stroke-dashoffset: 112;
    animation: set-play-draw 300ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
  }
  .set-play-run-b {
    stroke-dasharray: 139;
    stroke-dashoffset: 139;
    animation: set-play-draw 300ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
  }
  .set-play-run-c {
    stroke-dasharray: 345;
    stroke-dashoffset: 345;
    animation: set-play-draw 450ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
  }
  .set-play-run-d {
    stroke-dasharray: 202;
    stroke-dashoffset: 202;
    animation: set-play-draw 350ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
  }
  .set-play-run-e {
    stroke-dasharray: 110;
    stroke-dashoffset: 110;
    animation: set-play-draw 300ms cubic-bezier(0.22, 1, 0.36, 1) 300ms forwards;
  }

  .set-play-head-a,
  .set-play-head-b,
  .set-play-head-e {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 580ms forwards;
  }
  .set-play-head-c {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 720ms forwards;
  }
  .set-play-head-d {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 630ms forwards;
  }

  .set-play-pass1 {
    stroke-dasharray: 463;
    stroke-dashoffset: 463;
    animation: set-play-draw 450ms cubic-bezier(0.22, 1, 0.36, 1) 800ms forwards;
  }

  .set-play-pass1-head {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 1220ms forwards;
  }

  .set-play-arc-reveal {
    stroke-dasharray: 614;
    stroke-dashoffset: 614;
    animation: set-play-draw 550ms cubic-bezier(0.22, 1, 0.36, 1) 800ms forwards;
  }

  .set-play-arc-head {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 1330ms forwards;
  }

  .set-play-pass2 {
    stroke-dasharray: 301;
    stroke-dashoffset: 301;
    animation: set-play-draw 400ms cubic-bezier(0.22, 1, 0.36, 1) 1500ms forwards;
  }

  .set-play-pass2-head {
    opacity: 0;
    animation: set-play-appear 150ms ease-out 1870ms forwards;
  }

  @keyframes set-play-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes set-play-appear {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .set-play-static,
    .set-play-run,
    .set-play-head,
    .set-play-pass1,
    .set-play-pass1-head,
    .set-play-arc-reveal,
    .set-play-arc-head,
    .set-play-pass2,
    .set-play-pass2-head {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }
</style>
