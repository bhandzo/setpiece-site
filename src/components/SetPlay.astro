---
// ABOUTME: Decorative rugby set-play notation SVG for the homepage hero —
// ABOUTME: one designed play: anchor cluster bottom-left, solid 45° play line up the clear right side, support runner arcing onto the target space.
---

<svg
  aria-hidden="true"
  class="set-play"
  fill="none"
  preserveAspectRatio="xMidYMid slice"
  viewBox="0 0 1280 720"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- support runner: arcs out of the pocket, converging on the target space -->
  <path
    class="set-play-run"
    d="M1085 430 Q1112 285 1047 222"
    stroke-dasharray="12 10"
    stroke-width="2"
  ></path>

  <!-- the designed play: one solid 45° diagonal from the cluster, up the clear
       right side of the headline into the open upper-right quadrant -->
  <path class="set-play-line" d="M515 670 L1115 70" stroke-width="3"></path>
  <path
    class="set-play-arrow"
    d="M1083 82 L1115 70 L1103 102"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="3"
  ></path>

  <!-- players: anchor cluster bottom-left, runner in the pocket,
       open circle = the target position being attacked -->
  <circle class="set-play-dot" cx="290" cy="660" r="7"></circle>
  <circle class="set-play-dot" cx="395" cy="640" r="7"></circle>
  <circle class="set-play-dot" cx="515" cy="670" r="7"></circle>
  <circle class="set-play-dot" cx="1085" cy="430" r="7"></circle>
  <circle class="set-play-dot-open" cx="1035" cy="205" r="8" stroke-width="2"></circle>
</svg>

<style>
  /* Mobile: the play renders as its own block above the headline (full composition).
		   md+: it becomes the hero's background layer, cropped from the center. */
  .set-play {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .set-play {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
    }
  }

  /* Poster-stamp scale: the block renders ~350px wide, so thicken every mark
	   proportionally or the play reads as a wisp. */
  @media (max-width: 767px) {
    .set-play-line,
    .set-play-arrow {
      stroke-width: 6;
    }
    .set-play-run {
      stroke-width: 4;
      stroke-dasharray: 18 15;
    }
    .set-play-dot {
      r: 12px;
    }
    .set-play-dot-open {
      r: 14px;
      stroke-width: 4;
    }
  }

  .set-play-dot {
    fill: var(--color-ink);
  }

  .set-play-dot-open {
    stroke: var(--color-ink);
  }

  .set-play-run {
    stroke: var(--color-muted-dark);
  }

  .set-play-line,
  .set-play-arrow {
    stroke: var(--color-orange);
  }

  /* Draw the play line once on load; arrowhead lands as the stroke arrives. */
  .set-play-line {
    stroke-dasharray: 850;
    stroke-dashoffset: 850;
    animation: set-play-draw 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .set-play-arrow {
    opacity: 0;
    animation: set-play-land 200ms ease-out 700ms forwards;
  }

  @keyframes set-play-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes set-play-land {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .set-play-line {
      animation: none;
      stroke-dashoffset: 0;
    }
    .set-play-arrow {
      animation: none;
      opacity: 1;
    }
  }
</style>
