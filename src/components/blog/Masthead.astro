---
// ABOUTME: Post header for blog posts — title, serif subtitle, then a byline
// ABOUTME: row with author/date/reading time on the left and tags on the right.
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

<h1 class="display text-4xl md:text-5xl">
	{data.title}
</h1>
<p class="text-muted-dark mt-4 max-w-[38em] font-serif text-lg leading-relaxed">
	{data.description}
</p>
<div class="mt-6 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
	<p class="eyebrow text-muted-dark flex flex-wrap items-center gap-x-3">
		{data.draft ? <span class="text-orange">Draft</span> : null}
		<span>
			{data.author} ·
			<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} /> ·
			{readingTime}
		</span>
		{
			data.updatedDate && (
				<span class="text-quote">
					Updated:
					<FormattedDate class="ms-1" date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
				</span>
			)
		}
	</p>
	{
		!!data.tags?.length && (
			<div class="eyebrow text-muted-dark flex flex-wrap gap-x-4 gap-y-1">
				{data.tags.map((tag) => (
					<a
						class="hover:text-orange transition-colors"
						data-pagefind-filter={`tag:${tag}`}
						href={`/tags/${tag}/`}
					>
						<span class="sr-only">View more blogs with the tag&nbsp;</span>#{tag}
					</a>
				))}
			</div>
		)
	}
</div>
