---
// ABOUTME: Site footer — hairline top rule, mono meta: wordmark, copyright, nav links.
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
  class="gc-full border-t border-(--hairline) py-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 eyebrow"
>
  <p>
    {siteConfig.title} &copy; {year}
  </p>
  <nav aria-labelledby="footer_links" class="flex flex-wrap gap-x-6 gap-y-2">
    <p id="footer_links" class="sr-only">More on this site</p>
    {
      menuLinks.map((link) => (
        <a class="hover:text-accent transition-colors" href={link.path}>
          {link.title}
        </a>
      ))
    }
  </nav>
</footer>
