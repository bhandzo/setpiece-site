---
// ABOUTME: Site header with logo and navigation links.
// ABOUTME: Quiet Swiss treatment — wordmark left, mono-caps nav right, hairline rule below.
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks } from "@/site.config";
import { siteConfig } from "../../site.config";
---

<header
	class="gc-full flex items-center justify-between border-b border-(--hairline) py-5"
	id="main-header"
>
	<!-- Logo/Brand - Left side -->
	<a
		aria-current={Astro.url.pathname === "/" ? "page" : false}
		class="hover:text-accent flex items-center gap-3 transition-colors"
		href="/"
	>
		<img src="/logo.svg" alt="" class="h-7 w-7" />
		<span class="eyebrow">{siteConfig.title}</span>
	</a>

	<!-- Navigation - Right aligned -->
	<nav aria-label="Main menu" class="flex items-center gap-6" id="navigation-menu">
		{
			menuLinks.map((link) => (
				<a
					aria-current={Astro.url.pathname === link.path ? "page" : false}
					class="eyebrow hover:text-accent transition-colors"
					href={link.path}
				>
					{link.title}
				</a>
			))
		}
		{
			import.meta.env.DEV && (
				<a
					class="eyebrow border-orange bg-orange/10 text-orange hover:bg-orange inline-flex items-center gap-2 border px-2 py-1 transition-colors hover:text-[#222019]"
					href="/keystatic/"
					title="Open the Keystatic editor (development only)"
				>
					<span>Editor</span>
					<span aria-hidden="true" class="border-orange/40 border-s ps-2 text-[0.65rem]">
						dev
					</span>
					<span class="sr-only">Development only</span>
				</a>
			)
		}
		<ThemeToggle />
	</nav>
</header>
