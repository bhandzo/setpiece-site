---
// ABOUTME: Pagination links for blog listings, set in the mono utility voice
// ABOUTME: above a hairline rule.
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="eyebrow text-muted-dark mt-12 flex items-center border-t border-(--hairline) pt-6">
			{prevUrl && (
				<a class="hover:text-orange me-auto py-2 transition-colors" href={prevUrl.url}>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "Previous"}
				</a>
			)}
			{nextUrl && (
				<a class="hover:text-orange ms-auto py-2 transition-colors" href={nextUrl.url}>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "Next"}
				</a>
			)}
		</nav>
	)
}
