---
// ABOUTME: Blog listing — the "Set Play" contents table: masthead header,
// ABOUTME: blue year numerals anchoring hairline-ruled post rows, mono tag rail.
import type { CollectionEntry } from "astro:content";
import Pagination from "@/components/Paginator.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getUniqueTags, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import type { GetStaticPaths, Page } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const MAX_TAGS = 7;
	const MAX_PINNED_POSTS = 3;
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(allPosts).slice(0, MAX_TAGS);
	const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, MAX_PINNED_POSTS);
	return paginate(allPostsByDate, {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { uniqueTags, pinnedPosts },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	uniqueTags: string[];
	pinnedPosts: CollectionEntry<"post">[];
}

const { page, uniqueTags, pinnedPosts } = Astro.props;

const meta = {
	description: "Essays and field reports from Setpiece — product, data, and AI in practice.",
	title: "Blog",
};

const paginationProps = {
	...(page.url?.prev && {
		prevUrl: {
			text: "← Newer posts",
			url: page.url.prev,
		},
	}),
	...(page.url?.next && {
		nextUrl: {
			text: "Older posts →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<!-- Masthead — centered nameplate; the nav's own hairline above is the
	     only rule, so the title sits on open paper. -->
	<section class="gc-full mb-12">
		<div class="py-baseline text-center">
			<h1 class="display text-4xl md:text-5xl">Blog</h1>
			<p class="eyebrow text-muted-dark mt-4">
				<a class="hover:text-orange transition-colors" href="/rss.xml" target="_blank">
					RSS<span class="sr-only"> feed</span>
					<span aria-hidden="true">↗</span>
				</a>
			</p>
		</div>
	</section>
	<div class="gc-full grid-local md:gap-x-8 md:gap-y-16">
		<div class="gc-full md:col-span-4 lg:col-span-6">
			{
				pinnedPosts.length > 0 && (
					<section class="mb-16 grid gap-y-4 md:grid-cols-[112px_1fr] md:gap-x-6">
						<h2 class="eyebrow text-muted-dark md:pt-2">Pinned</h2>
						<ul class="divide-y divide-(--hairline) list-none" role="list">
							{pinnedPosts.map((p) => (
								<li class="ml-0 py-8 first:pt-0 last:pb-0">
									<PostPreview post={p} withDesc />
								</li>
							))}
						</ul>
					</section>
				)
			}
			{
				descYearKeys.map((yearKey) => (
					<section class="mb-16 grid gap-y-4 md:grid-cols-[112px_1fr] md:gap-x-6">
						{/* the year numeral reuses the services table's Maier-scale
						    row-numeral — both are contents tables, chronology is the
						    information the number encodes */}
						<h2 id={`year-${yearKey}`} class="row-numeral md:sticky md:top-24 md:self-start">
							<span class="sr-only">Posts in </span>
							{yearKey}
						</h2>
						<ul class="divide-y divide-(--hairline) list-none">
							{groupedByYear[yearKey]?.map((p) => (
								<li class="ml-0 py-8 first:pt-0 last:pb-0">
									<PostPreview post={p} withDesc />
								</li>
							))}
						</ul>
					</section>
				))
			}
			<Pagination {...paginationProps} />
		</div>
		{
			!!uniqueTags.length && (
				<aside class="gc-full md:col-span-2 lg:col-span-3">
					<h2 class="eyebrow text-muted-dark mb-4">Tags</h2>
					<ul class="eyebrow flex list-none flex-wrap gap-x-4 gap-y-2">
						{uniqueTags.map((tag) => (
							<li class="ml-0">
								<a class="hover:text-orange transition-colors" href={`/tags/${tag}/`}>
									<span class="sr-only">View all posts with the tag </span>
									<span aria-hidden="true">#</span>{tag}
								</a>
							</li>
						))}
					</ul>
					<a
						class="eyebrow text-muted-dark hover:text-orange mt-6 inline-block transition-colors"
						href="/tags/"
					>
						All tags <span aria-hidden="true">→</span>
						<span class="sr-only">blog tags</span>
					</a>
				</aside>
			)
		}
	</div>
</PageLayout>
