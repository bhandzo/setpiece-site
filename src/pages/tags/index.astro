---
// ABOUTME: All-tags index — a small contents table: masthead header, hairline
// ABOUTME: rows pairing each tag with its post count in the mono voice.
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	description: "Every topic covered on the Setpiece blog.",
	title: "Tags",
};
---

<PageLayout meta={meta}>
	<section class="gc-full mb-12">
		<div class="pb-baseline">
			<p class="eyebrow text-muted-dark">
				{allTags.length} topic{allTags.length === 1 ? "" : "s"}
			</p>
			<h1 class="display mt-3 text-4xl md:text-5xl">Tags</h1>
		</div>
	</section>
	<ul class="gc-full max-w-[44rem] list-none divide-y divide-(--hairline)">
		{
			allTags.map(([tag, val]) => (
				<li class="ml-0 flex items-baseline py-4">
					<a
						class="hover:text-orange text-xl font-bold tracking-tight transition-colors"
						href={`/tags/${tag}/`}
						title={`View posts with the tag: ${tag}`}
					>
						<span aria-hidden="true">#</span>
						{tag}
					</a>
					<span class="eyebrow text-muted-dark ms-auto">
						{val} post{val === 1 ? "" : "s"}
					</span>
				</li>
			))
		}
	</ul>
</PageLayout>
