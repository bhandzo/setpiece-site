---
// ABOUTME: Homepage — "Set Play" Swiss-grid layout: hero with set-play notation,
// ABOUTME: sections bounded by full-bleed scrimmed imagery and color planes, Studio OG-card carousel, services accordion, team.
import SetPlay from "@/components/SetPlay.astro";
import StudioCarousel from "@/components/StudioCarousel.astro";
import PageLayout from "@/layouts/Base.astro";
import { Image } from "astro:assets";
import flags from "@/content/images/Flags.jpeg";
import lightsCropped from "@/content/images/Lights_Cropped.jpg";
import hills from "@/content/images/hills.jpg";
import { getCollection } from "astro:content";

// Homepage copy is managed by the Keystatic "homepage" singleton, stored as JSON
import homepage from "@/content/homepage.json";

// Get collections data
const problemCardsCollection = (await getCollection("problemCards")) || [];
const differentiatorsCollection =
  (await getCollection("differentiators")) || [];
const servicesCollection = (await getCollection("services")) || [];
const teamMembersCollection = (await getCollection("teamMembers")) || [];
const studioProductsCollection = (await getCollection("studioProducts")) || [];

// Sort collections by order
problemCardsCollection.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
differentiatorsCollection.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);
servicesCollection.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
teamMembersCollection.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
studioProductsCollection.sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

// Collections are already rendered with Astro v5+
const problemCards = problemCardsCollection;
const differentiators = differentiatorsCollection;
const services = servicesCollection;
const teamMembers = teamMembersCollection;
const studioProducts = studioProductsCollection;

// Use the homepage data and fail loudly if it doesn't exist
if (!homepage) {
  throw new Error("Homepage data not found at src/content/homepage.json");
}

const content = homepage;
---

<PageLayout meta={{ title: "Setpiece" }}>
  <!-- 1. Hero — headline over the set-play notation -->
  <section class="gc-full relative lg:min-h-[80vh] flex flex-col">
    <SetPlay />
    <div
      class="relative grid grid-cols-1 lg:grid-cols-12 lg:gap-x-6 w-full flex-1 content-between pt-6 pb-20 md:pt-24 md:pb-24 lg:pb-12 gap-y-16"
    >
      <h1
        class="display text-[clamp(2.75rem,6vw,5.5rem)] col-span-full lg:col-span-10"
      >
        {content.heroTitle}
      </h1>
      <!-- description starts on grid line 9 — the same column as the problem
           section's description, so the two blocks rule one vertical line -->
      <p
        class="text-lg leading-relaxed max-w-[34em] col-span-full lg:col-start-9 lg:col-span-4"
      >
        {content.heroDescription}
      </p>
    </div>
  </section>

  <!-- 2. Problem — bounded by a full-bleed scrimmed photograph; the image edge
       is the section boundary. Theme-independent: same in light and dark. -->
  <section class="gc-full bleed relative">
    <div class="scrim-backdrop" aria-hidden="true">
      <Image alt="" sizes="100vw" src={hills} widths={[768, 1440, 2560]} />
    </div>
    <div
      class="relative w-[min(1280px,100%)] mx-auto px-(--margin) py-20 md:py-28"
    >
      <p class="eyebrow text-[#F1ECE2]/80 mb-6">The problem</p>
      <div
        class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-6 items-start mb-14 md:mb-20 text-[#F1ECE2]"
      >
        <h2
          class="display text-[clamp(2rem,4vw,3.25rem)] lg:col-span-7"
        >
          {content.mainProblemTitle}
        </h2>
        <!-- description starts on grid line 9 — the left edge of the third card below -->
        <p
          class="text-lg leading-relaxed max-w-[34em] lg:col-start-9 lg:col-span-4"
        >
          {content.mainProblemDescription}
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-x-6 gap-y-12 text-[#F1ECE2]">
        {
          problemCards.map((card) => (
            <article class="border-t-[5px] border-[#F1ECE2] pt-6 md:pt-8">
              <h3 class="text-xl font-bold tracking-tight mb-4">
                {card.data.title}
              </h3>
              <div
                class="leading-relaxed space-y-4"
                set:html={card.rendered?.html}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. Differentiators — full-bleed slate-blue plane. -mt-6 cancels the
       grid-frame's 24px row gap so the blue plane sits flush against the
       hills image edge: zero paper at the seam. -->
  <section class="gc-full bleed bg-blue text-[#F1ECE2] -mt-6">
    <div
      class="w-[min(1280px,100%)] mx-auto px-(--margin) py-20 md:py-28 grid gap-y-12 lg:grid-cols-3 lg:gap-x-6"
    >
      <h2 class="display text-[clamp(2rem,4vw,3.25rem)] lg:col-span-1">
        {content.differentiatorTitle}
      </h2>
      <div class="lg:col-span-2 divide-y divide-[rgba(241,236,226,0.35)]">
        {
          differentiators.map((diff) => (
            <article class="py-8 first:pt-0 last:pb-0">
              <h3 class="text-xl font-bold tracking-tight mb-3">
                {diff.data.title}
              </h3>
              <div
                class="leading-relaxed space-y-4 max-w-[38em]"
                set:html={diff.rendered?.html}
              />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Setpiece Studio — deck-cover v2: full-width headline and subhead over
       the lights photograph in full color at container width, a solid orange
       bar flush across the image's top edge (the deck spine, laid horizontal).
       Products follow as an OG-card carousel — each card its own brand artifact.
       pt matches the services→flags paper gap so both full-bleed seams read equal. -->
  <section class="gc-full pt-24 pb-24 md:pt-32 md:pb-32">
    <p class="eyebrow text-(--color-muted-dark) mb-6">Setpiece Studio</p>

    <div class="mb-16 md:mb-24">
      <h2 class="display text-[clamp(2.75rem,6vw,5.25rem)]">
        {content.studioTitle}
      </h2>
      <p class="text-lg leading-relaxed max-w-[44em] mt-6 md:mt-8 mb-12 md:mb-16">
        {content.studioDescription}
      </p>
      <div>
        <div class="h-12 lg:h-16 bg-orange" aria-hidden="true"></div>
        <Image
          alt=""
          class="w-full object-cover h-[260px] md:h-[420px] lg:h-[520px]"
          sizes="(min-width: 1280px) 1184px, 100vw"
          src={lightsCropped}
          widths={[768, 1440, 2048]}
        />
      </div>
    </div>

    <StudioCarousel products={studioProducts} />
  </section>

  <!-- 5. Services — 1/3 header column, 2/3 accordion: 01–04 engagement arc as
       hairline rows with plus-in-circle affordances. The one place drawn
       hairlines are honest: a table of contents. -->
  <section class="gc-full pb-24 md:pb-32">
    <div class="grid gap-y-10 lg:grid-cols-3 lg:gap-x-6 items-start">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <p class="eyebrow text-(--color-muted-dark) mb-6">Services</p>
        <h2 class="display text-[clamp(2rem,4vw,3.25rem)]">
          {content.servicesTitle}
        </h2>
        <p class="text-lg leading-relaxed max-w-[34em] mt-6">
          {content.servicesSubtitle}
        </p>
      </div>

      <div class="lg:col-span-2">
        <div class="svc-acc border-t border-(--hairline)">
          {
            services.map((service, i) => (
              <details name="services-accordion">
                <summary>
                  <p class="row-numeral">{String(i + 1).padStart(2, "0")}</p>
                  <h3 class="text-xl md:text-2xl font-bold tracking-tight">
                    {service.data.title}
                  </h3>
                  <span class="svc-icon" aria-hidden="true"></span>
                </summary>
                <div class="svc-body service-desc" set:html={service.rendered?.html} />
              </details>
            ))
          }
        </div>
        <!-- the deck's guarantee line, CMS-editable via servicesDescription -->
        <p class="text-base font-bold tracking-tight mt-8">
          {content.servicesDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Team — bounded by the full-bleed scrimmed flags photograph; the two
       operators sit on top as solid surface cards (theme-aware). -->
  <section class="gc-full bleed relative">
    <div class="scrim-backdrop" aria-hidden="true">
      <Image alt="" sizes="100vw" src={flags} widths={[768, 1440, 2560]} />
    </div>
    <div
      class="relative w-[min(1280px,100%)] mx-auto px-(--margin) py-20 md:py-28"
    >
      <p class="eyebrow text-[#F1ECE2]/80 mb-6">About</p>
      <div
        class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-6 items-start mb-14 md:mb-20 text-[#F1ECE2]"
      >
        <h2
          class="display text-[clamp(2rem,4vw,3.25rem)] lg:col-span-6"
        >
          {content.aboutUsTitle}
        </h2>
        <!-- description starts on grid line 7 — the left edge of the second bio card below -->
        <p
          class="text-lg leading-relaxed max-w-[34em] lg:col-start-7 lg:col-span-6"
        >
          {content.aboutUsDescription}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {
          teamMembers.map((member) => (
            <article class="bg-bone p-8 md:p-10">
              <h3 class="text-2xl font-bold tracking-tight mb-1">
                {member.data.name
                  .replace(/-/g, " ")
                  .replace(/\b\w/g, (l) => l.toUpperCase())}
              </h3>
              <p class="eyebrow text-(--color-muted-dark) mb-6">
                {member.data.title}
              </p>
              <div
                class="leading-relaxed space-y-4 mb-8"
                set:html={member.rendered?.html}
              />
              <ul class="eyebrow space-y-2 border-t border-(--hairline) pt-6 list-none">
                {member.data.specializations.map((spec) => (
                  <li class="ml-0">{spec}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
