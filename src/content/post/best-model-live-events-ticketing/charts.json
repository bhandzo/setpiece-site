      "size": 700,
      "strokeWidth": 2.5,
      "opacity": 1
     },
     "encoding": {
      "x": {
       "field": "minutes",
       "type": "quantitative"
      },
      "y": {
       "field": "lines",
       "type": "quantitative"
      },
      "color": {
       "field": "model",
       "type": "nominal",
       "scale": {
        "domain": [
         "Opus 5",
         "Sonnet 4.6",
         "Terra",
         "Luna",
         "Gemini 3.5F",
         "Gemini 3.6F",
         "GLM 5.2",
         "Echo"
        ],
        "range": [
         "#963F04",
         "#EE7D0E",
         "#1D5CAD",
         "#4D96F2",
         "#0F7D5A",
