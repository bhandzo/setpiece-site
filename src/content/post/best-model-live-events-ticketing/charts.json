{
  "vegaSpecs": {
    "bubbleTrade": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {
        "name": "modelSummary"
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.9
          },
          "encoding": {
            "x": {
              "field": "minutes",
              "type": "quantitative",
              "title": "Avg minutes per deep question →",
              "scale": {
                "domainMin": 0,
                "domainMax": 3.8
              },
              "axis": {
                "tickCount": 5
              }
            },
            "y": {
              "field": "lines",
              "type": "quantitative",
              "title": "Avg lines per answer ↑",
              "scale": {
                "domainMin": 0,
                "domainMax": 58
              },
              "axis": {
                "tickCount": 6
              }
            },
            "size": {
              "field": "costPerQ",
              "type": "quantitative",
              "title": "Avg $ / question",
              "scale": {
                "range": [200, 2600]
              },
              "legend": null
            },
            "color": {
              "field": "model",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Opus 5",
                  "Sonnet 4.6",
                  "Terra",
                  "Luna",
                  "Gemini 3.6F",
                  "GLM 5.2",
                  "Echo"
                ],
                "range": [
                  "#963F04",
                  "#EE7D0E",
                  "#1D5CAD",
                  "#4D96F2",
                  "#4FBA8C",
                  "#8040A0",
                  "#C75A88"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "model",
                "title": "Model"
              },
              {
                "field": "minutes",
                "title": "Avg minutes"
              },
              {
                "field": "lines",
                "title": "Avg lines"
              },
              {
                "field": "costLabel",
                "title": "Avg $ / question"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "indexof(['Luna','GLM 5.2','Opus 5'], datum.model) < 0"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -22,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "minutes",
              "type": "quantitative"
            },
            "y": {
              "field": "lines",
              "type": "quantitative"
            },
            "text": {
              "field": "model"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.model == 'Opus 5'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -38,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "minutes",
              "type": "quantitative"
            },
            "y": {
              "field": "lines",
              "type": "quantitative"
            },
            "text": {
              "field": "model"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.model == 'Luna' || datum.model == 'GLM 5.2'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": 22,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "minutes",
              "type": "quantitative"
            },
            "y": {
              "field": "lines",
              "type": "quantitative"
            },
            "text": {
              "field": "model"
            }
          }
        }
      ],
      "width": "container",
      "height": 380,
      "background": "transparent"
    },
    "answerScatter": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {
        "name": "answers"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "stroke": "rgba(34,32,25,0.45)",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "minutes",
          "type": "quantitative",
          "title": "Minutes to answer →",
          "axis": {
            "tickCount": 6
          }
        },
        "y": {
          "field": "words",
          "type": "quantitative",
          "title": "Words in the answer ↑",
          "axis": {
            "tickCount": 6
          }
        },
        "color": {
          "field": "model",
          "type": "nominal",
          "title": "Model",
          "scale": {
            "domain": ["Opus 5", "Sonnet 4.6", "Terra", "Luna", "Gemini 3.6F", "GLM 5.2", "Echo"],
            "range": ["#963F04", "#EE7D0E", "#1D5CAD", "#4D96F2", "#4FBA8C", "#8040A0", "#C75A88"]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": null,
            "columns": 4,
            "columnPadding": 26,
            "rowPadding": 8,
            "labelLimit": 200,
            "offset": 24
          }
        },
        "tooltip": [
          {
            "field": "model",
            "title": "Model"
          },
          {
            "field": "exercise",
            "title": "Exercise"
          },
          {
            "field": "minutes",
            "title": "Minutes"
          },
          {
            "field": "words",
            "title": "Words"
          }
        ],
        "opacity": {
          "condition": {
            "param": "modelSel",
            "value": 0.9
          },
          "value": 0.12
        }
      },
      "width": "container",
      "height": 380,
      "background": "transparent",
      "params": [
        {
          "name": "modelSel",
          "select": {
            "type": "point",
            "fields": ["model"]
          }
        }
      ]
    },
    "stepScatter": {
      "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
      "data": {
        "name": "perStep"
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 220,
            "stroke": "rgba(34,32,25,0.45)",
            "strokeWidth": 0.8,
            "opacity": 0.9
          },
          "encoding": {
            "x": {
              "field": "callsPerStep",
              "type": "quantitative",
              "title": "Tool calls per round-trip →",
              "scale": {
                "domainMin": 0.8,
                "domainMax": 2.1
              },
              "axis": {
                "tickCount": 6
              }
            },
            "y": {
              "field": "secPerStep",
              "type": "quantitative",
              "title": "Seconds per round-trip ↑",
              "scale": {
                "domainMin": 0,
                "domainMax": 14.5
              },
              "axis": {
                "tickCount": 6
              }
            },
            "color": {
              "field": "model",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Opus 5",
                  "Sonnet 4.6",
                  "Terra",
                  "Luna",
                  "Gemini 3.6F",
                  "GLM 5.2",
                  "Echo"
                ],
                "range": [
                  "#963F04",
                  "#EE7D0E",
                  "#1D5CAD",
                  "#4D96F2",
                  "#4FBA8C",
                  "#8040A0",
                  "#C75A88"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "model",
                "title": "Model"
              },
              {
                "field": "callsPerStep",
                "title": "Calls / round-trip"
              },
              {
                "field": "secPerStep",
                "title": "Sec / round-trip"
              },
              {
                "field": "calls",
                "title": "Avg tool calls / question"
              },
              {
                "field": "steps",
                "title": "Avg round-trips / question"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.model != 'Luna'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -16,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "callsPerStep",
              "type": "quantitative"
            },
            "y": {
              "field": "secPerStep",
              "type": "quantitative"
            },
            "text": {
              "field": "model"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.model == 'Luna'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": 20,
            "fontSize": 11
          },
          "encoding": {
            "x": {
              "field": "callsPerStep",
              "type": "quantitative"
            },
            "y": {
              "field": "secPerStep",
              "type": "quantitative"
            },
            "text": {
              "field": "model"
            }
          }
        }
      ],
      "width": "container",
      "height": 340,
      "background": "transparent"
    }
  },
