  "bubbleTrade": {
   "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
   "data": {
    "name": "modelSummary"
   },
   "layer": [
    {
     "transform": [
      {
       "filter": "datum.costPerQ != null"
      }
     ],
     "mark": {
      "type": "circle",
      "opacity": 0.9
     },
     "encoding": {
      "x": {
       "field": "minutes",
       "type": "quantitative",
       "title": "Avg minutes per deep question \u2192",
       "scale": {
        "domainMin": 0,
        "domainMax": 4.6
       },
       "axis": {
        "tickCount": 5
       }
      },
      "y": {
       "field": "lines",
       "type": "quantitative",
       "title": "Avg lines per answer \u2191",
       "scale": {
        "domainMin": 0,
        "domainMax": 58
       },
       "axis": {
        "tickCount": 6
       }
      },
      "size": {
       "field": "costPerQ",
       "type": "quantitative",
       "title": "Avg $ / question",
       "scale": {
        "range": [
         200,
         2600
        ]
       },
       "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "symbolFillColor": "#8A8474",
        "symbolStrokeWidth": 0,
        "titleOrient": "left",
        "offset": 24
       }
      },
      "color": {
       "field": "model",
       "type": "nominal",
       "scale": {
        "domain": [
         "Opus 5",
         "Sonnet 4.6",
         "Terra",
         "Luna",
         "Gemini 3.5F",
         "Gemini 3.6F",
         "GLM 5.2",
         "Echo"
        ],
        "range": [
         "#963F04",
         "#EE7D0E",
         "#1D5CAD",
         "#4D96F2",
         "#0F7D5A",
         "#4FBA8C",
         "#8040A0",
         "#C75A88"
        ]
       },
       "legend": null
      },
      "tooltip": [
       {
        "field": "model",
        "title": "Model"
       },
       {
        "field": "minutes",
        "title": "Avg minutes"
       },
       {
        "field": "lines",
        "title": "Avg lines"
       },
       {
        "field": "costLabel",
        "title": "Avg $ / question"
       }
      ]
     }
    },
    {
     "transform": [
      {
       "filter": "datum.costPerQ == null"
      }
