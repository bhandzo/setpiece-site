      "type": "text",
      "dy": -22,
      "fontSize": 11
     },
     "encoding": {
      "x": {
       "field": "minutes",
       "type": "quantitative"
      },
      "y": {
       "field": "lines",
       "type": "quantitative"
      },
      "text": {
       "field": "model"
      }
     }
    },
    {
