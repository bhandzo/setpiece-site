{
	"name": "setpiece-site",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:local": "astro dev --mode keystatic-local",
		"start": "astro dev",
		"build": "SKIP_KEYSTATIC=true astro build",
		"preview": "SKIP_KEYSTATIC=true astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*.astro\" --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@astrojs/markdoc": "~2.1.1",
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/mdx": "8.1.1",
		"@astrojs/react": "^7.1.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.3",
		"@markdoc/markdoc": "^0.5.10",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"astro": "7.4.2",
		"astro-expressive-code": "^0.44.3",
		"astro-favicons": "3.1.8",
		"astro-icon": "^1.2.0",
		"cssnano": "^7.1.9",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.0",
		"mdast-util-to-string": "^4.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.33.5",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vega": "6.2.0",
		"vega-embed": "7.1.0",
		"vega-interpreter": "2.2.1",
		"vega-lite": "6.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.5.5",
		"@iconify-json/mdi": "^1.2.3",
		"@pagefind/default-ui": "^1.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.6.1",
		"mdast-util-to-hast": "^13.2.1",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	}
}
