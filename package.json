{
	"name": "setpiece-site",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:local": "KEYSTATIC_LOCAL=1 astro dev",
		"start": "astro dev",
		"build": "SKIP_KEYSTATIC=true astro build",
		"preview": "SKIP_KEYSTATIC=true astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@astrojs/markdoc": "^2.0.6",
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "7.0.5",
		"@astrojs/react": "^6.0.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@keystatic/astro": "^5.2.0",
		"@keystatic/core": "^0.6.3",
		"@markdoc/markdoc": "^0.5.4",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "^19.1.12",
		"@types/react-dom": "^19.1.9",
		"astro": "7.1.6",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"cssnano": "^7.0.7",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.15.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.0.6",
		"@iconify-json/mdi": "^1.2.2",
		"@pagefind/default-ui": "^1.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"autoprefixer": "^10.4.21",
		"pagefind": "^1.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"reading-time": "^1.5.0",
		"tailwindcss": "4.3.3",
		"typescript": "^5.8.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
